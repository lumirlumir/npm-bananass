{
  "private": true,
  "name": "npm-bananass",
  "version": "0.8.0",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "^22.23.0 || ^24.15.0 || >=26.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.23.0 || ^24.15.0 || >=26.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10.9.8",
      "onFail": "error"
    }
  },
  "workspaces": [
    "examples/*",
    "packages/*",
    "packages/create-bananass/templates/*",
    "tests",
    "website"
  ],
  "scripts": {
    "prepare": "husky",
    "release:publish": "node -e \"require('child_process').execSync('npm publish -w packages ' + (require('./package.json').version.includes('-') ? '--tag next' : ''), { stdio: 'inherit' })\"",
    "release:version": "node ./scripts/version.js",
    "test": "npm-run-all -c -l -p --aggregate-output \"test:!(coverage)**\"",
    "test:coverage": "c8 --reporter=lcov npm run test",
    "test:types": "tsc -b",
    "test:ex:sb-cjs": "npm run test -w examples/solutions-bananass-cjs",
    "test:ex:sb-cts": "npm run test -w examples/solutions-bananass-cts",
    "test:ex:sb-mjs": "npm run test -w examples/solutions-bananass-mjs",
    "test:ex:sb-mts": "npm run test -w examples/solutions-bananass-mts",
    "test:pkg:b": "npm run test -w packages/bananass",
    "test:pkg:buc": "npm run test -w packages/bananass-utils-console",
    "test:pkg:cb": "npm run test -w packages/create-bananass",
    "test:t": "npm run test -w tests",
    "build": "npm-run-all -c -l --aggregate-output build:pkg -p build:w",
    "build:pkg": "tsc -b tsconfig.build.json",
    "build:ex:sb-cjs": "npm run build -w examples/solutions-bananass-cjs",
    "build:ex:sb-cts": "npm run build -w examples/solutions-bananass-cts",
    "build:ex:sb-mjs": "npm run build -w examples/solutions-bananass-mjs",
    "build:ex:sb-mts": "npm run build -w examples/solutions-bananass-mts",
    "build:pkg:b": "npm run build -w packages/bananass",
    "build:pkg:buc": "npm run build -w packages/bananass-utils-console",
    "build:pkg:cb": "npm run build -w packages/create-bananass",
    "build:w": "npm run build -w website",
    "dev": "npm run dev:w",
    "dev:pkg:b": "npm run dev -w packages/bananass",
    "dev:w": "npm run dev -w website",
    "start": "npm run start:w",
    "start:w": "npm run start -w website",
    "run:ex:sb-cjs": "npm run run -w examples/solutions-bananass-cjs",
    "run:ex:sb-cts": "npm run run -w examples/solutions-bananass-cts",
    "run:ex:sb-mjs": "npm run run -w examples/solutions-bananass-mjs",
    "run:ex:sb-mts": "npm run run -w examples/solutions-bananass-mts",
    "fix": "npm-run-all -c -l -p fix:*",
    "fix:eslint": "eslint --fix --cache --cache-strategy content",
    "fix:prettier": "prettier . --write --ignore-unknown",
    "lint": "npm-run-all -c -l -p lint:*",
    "lint:eslint": "eslint --cache --cache-strategy content",
    "lint:prettier": "prettier . --check --ignore-unknown",
    "lint:editorconfig": "editorconfig-checker -config .editorconfig-checker.json"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "c8": "^12.0.0",
    "editorconfig-checker": "^6.2.0",
    "eslint": "^10.13.0",
    "eslint-lumir": "^0.0.0-canary.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3"
  }
}
