{
  "name": "bananass-utils-console",
  "version": "0.8.0",
  "type": "module",
  "description": "Console Utilities for Bananass Framework.🍌",
  "exports": {
    "./icons": {
      "types": "./build/icons.d.ts",
      "default": "./build/icons.js"
    },
    "./is-interactive": {
      "types": "./build/is-interactive.d.ts",
      "default": "./build/is-interactive.js"
    },
    "./is-unicode-supported": {
      "types": "./build/is-unicode-supported.d.ts",
      "default": "./build/is-unicode-supported.js"
    },
    "./logger": {
      "types": "./build/logger.d.ts",
      "default": "./build/logger.js"
    },
    "./spinner": {
      "types": "./build/spinner.d.ts",
      "default": "./build/spinner.js"
    },
    "./theme": {
      "types": "./build/theme.d.ts",
      "default": "./build/theme.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./build/*"
      ],
      "icons": [
        "./build/icons.d.ts"
      ],
      "is-interactive": [
        "./build/is-interactive.d.ts"
      ],
      "is-unicode-supported": [
        "./build/is-unicode-supported.d.ts"
      ],
      "logger": [
        "./build/logger.d.ts"
      ],
      "spinner": [
        "./build/spinner.d.ts"
      ],
      "theme": [
        "./build/theme.d.ts"
      ]
    }
  },
  "files": [
    "build",
    "LICENSE.md",
    "README.md"
  ],
  "keywords": [
    "bananass",
    "baekjoon",
    "framework",
    "javascript",
    "typescript",
    "utils",
    "console",
    "icon",
    "logger",
    "spinner",
    "theme"
  ],
  "author": "lumir <rpfos@naver.com> (https://github.com/lumirlumir)",
  "funding": "https://github.com/sponsors/lumirlumir",
  "license": "MIT",
  "homepage": "https://bananass.lumir.page",
  "repository": {
    "type": "github",
    "url": "git+https://github.com/lumirlumir/npm-bananass.git",
    "directory": "packages/bananass-utils-console"
  },
  "bugs": {
    "url": "https://github.com/lumirlumir/npm-bananass/issues"
  },
  "engines": {
    "node": "^22.23.0 || ^24.15.0 || >=26.0.0"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsc -b tsconfig.build.json && node ../../scripts/cp.js ../../LICENSE.md LICENSE.md ../../README.md README.md",
    "test": "npm run test:types && npm run test:unit",
    "test:types": "tsc -b tsconfig.json",
    "test:unit": "node --test"
  }
}
